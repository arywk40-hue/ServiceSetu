# Copy to .env. Keep all keys private. Local proofs need no keys.
ASI1_API_KEY=
ASI1_MODEL=asi1
AGENTVERSE_API_KEY=
# Generate once: python3 -c 'import secrets; print(secrets.token_hex(32))'
SERVICESETU_SEED=
SERVICESETU_DB=data/servicesetu.db
SERVICESETU_PORT=8000
# local uses Bureau only; mailbox connects agents through Agentverse.
SERVICESETU_MAILBOX=false
# Test-only rails: mock, stripe_test, razorpay_test, or fet_testnet (Dorado only).
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Legacy setting; card-only embedded checkout now disables redirects.
STRIPE_RETURN_URL=https://asi1.ai
# Dorado atestfet amount is shown separately; no INR conversion is implemented.
FET_TEST_AMOUNT=0.1
FET_NETWORK=dorado-1
FET_USE_TESTNET=true
FET_PAYMENT_DEADLINE_SECONDS=300
# Protect local cancellation controls. Generate a separate random token.
DEMO_CONTROL_TOKEN=

# Google Places API (New) for real local-service discovery on Google Maps.
# Setup instructions:
# 1. Project: Create or select a Google Cloud project at https://console.cloud.google.com/
# 2. Billing: Link an active billing account and check current per-SKU allowances and pricing.
# 3. Enable API: Enable 'Places API (New)' in APIs & Services > Library.
# 4. API Key: Create an API key in APIs & Services > Credentials.
# 5. Restrictions: Set API restriction to 'Places API (New)' and restrict application IP/server.
# 6. Usage Quotas: Set daily request quotas in Cloud Console to prevent unexpected costs.
# Server-side only: never expose this key in model prompts, cards, client code, or commits.
GOOGLE_PLACES_API_KEY=

# Optional backend MCP integrations. Keep real keys in private .env only.
# TomTom requires MCP Server and Search/Geocoding/Routing product permissions.
TOMTOM_API_KEY=
# Taskrabbit's published MCP endpoint currently needs no key or sign-in.
